{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own narrow commands, listen for events, set its title, and minimize, maximize, move and close itself (it draws its own title bar). It has no file system, dialog, shell or opener permission of its own.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "allow-choose-document",
    "allow-choose-folder",
    "allow-list-folder",
    "allow-read-document",
    "allow-save-document",
    "allow-save-document-as",
    "allow-export-html",
    "allow-open-external",
    "allow-read-image",
    "allow-paste-image",
    "allow-copy-dropped-image",
    "allow-resolve-link",
    "allow-inspect-link-file",
    "allow-open-link-file",
    "allow-initial-document",
    "allow-remember-session",
    "allow-recent-files",
    "allow-add-recent",
    "allow-remove-recent",
    "allow-clear-recent",
    "allow-open-recent"
  ]
}
