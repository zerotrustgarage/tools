{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTG Readout",
  "mainBinaryName": "ztg-readout",
  "version": "../package.json",
  "identifier": "sh.ztg.readout",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZTG Readout",
        "width": 1320,
        "height": 860,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost blob: https://api.github.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Proudlock Technology LLC",
    "copyright": "Copyright Proudlock Technology LLC",
    "category": "Productivity",
    "shortDescription": "Source-faithful Markdown editor and viewer"
  }
}
