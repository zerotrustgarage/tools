{
  "name": "ztg-tools",
  "private": true,
  "workspaces": [
    "readout"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present && npm run test:signing && npm run check:palette && npm run check:icons && npm run check:updates",
    "test:signing": "node --test \"scripts/signing/*.test.mjs\"",
    "check:palette": "node scripts/ci/check-palette.mjs",
    "check:icons": "node scripts/ci/check-icons.mjs",
    "check:updates": "node scripts/updates/sync.mjs --check && node scripts/updates/client.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
